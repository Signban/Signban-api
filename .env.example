# Application
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# PostgreSQL (development and test)
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=signban
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DIALECT=postgres

# PostgreSQL (production)
DATABASE_URL=postgresql://signban:change-me@postgres:5432/signban
DB_SSL=false

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=

# Google Gemini
GEMINI_API_KEY=

# Gmail SMTP
MAIL_USER=
MAIL_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
